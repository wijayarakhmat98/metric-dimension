#!/usr/bin/env bash

set -euo pipefail

export METHOD=''
export METHOD="${METHOD} bruteforce"
export METHOD="${METHOD} boolean_satisfiability"
export METHOD="${METHOD} linear_integer_arithmetic"
export METHOD="${METHOD} pseudo_boolean"

export TIMEOUT=300
export INPUT='benchmark-source'
export OUTPUT='benchmark-result'
export SATURATION=10

target="${INPUT}/${NAME}.g6"

mkdir -p "${OUTPUT}"
rm -f "${target}"

echo "Creating ${target} for ${NAME} job..."
for vertices in $VERTICES; do
	for method in ${METHOD}; do
		source="${INPUT}/vertices-${vertices}.g6"
		echo "Reading ${source}... Generating for ${method}..."
		cat "${source}" | ./process jsonify | ./process add --key='metric_dimension' | ./process add --key='edge_metric_dimension' | ./process add --key='algorithm' --value="${method}" | ./sort >> "${target}"
	done
done

source="${target}"
target="${OUTPUT}/${NAME}.txt"

for ((i = 1; i <= $SATURATION; ++i)); do
	echo "Saturating CPU... (${i} of ${SATURATION})"
	nauty-geng -cq 8 | ./process jsonify | ./process add --key='metric_dimension' | ./process add --key='edge_metric_dimension' | ./process add --key='algorithm' --value='pseudo_boolean' | ./process metric_dimension > /dev/null
done

echo 'Processing...'
./process metric_dimension < "${source}" > "${target}"
