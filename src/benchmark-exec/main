#!/usr/bin/env bash

set -euo pipefail

export MODE=''
export MODE="${MODE} metric-dimension"
export MODE="${MODE} edge-metric-dimension"

export METHOD=''
export METHOD="${METHOD} bruteforce"
export METHOD="${METHOD} boolean_satisfiability"
export METHOD="${METHOD} linear_integer_arithmetic"
export METHOD="${METHOD} pseudo_boolean"

export TIMEOUT=300
export INPUT='benchmark-source'
export OUTPUT='benchmark-result'
export SATURATION=5

mkdir -p "${OUTPUT}"

for ((i = 1; i <= $SATURATION; ++i)); do
	echo "Initial ${i} of ${SATURATION}... Saturating CPU..."
	nauty-geng -cq 8 | ./process jsonify | ./process metric_dimension -a=pseudo_boolean | ./process metric_dimension -f=edge-metric-dimension -a=pseudo_boolean > /dev/null
done

for vertices in $VERTICES; do
	echo "[VERTICES ${vertices}] Saturating CPU..."
	nauty-geng -cq 8 | ./process jsonify | ./process metric_dimension -a=pseudo_boolean | ./process metric_dimension -f=edge-metric-dimension -a=pseudo_boolean > /dev/null
	for mode in ${MODE}; do
		for method in ${METHOD}; do
			source="${INPUT}/vertices-${vertices}.txt"
			target="${OUTPUT}/vertices-${vertices}.${mode}.${method}.txt"
			echo -e "[VERTICES ${vertices}]\t[FIND ${mode}] \t[ALGORITHM ${method}]"
			if [ "${mode}" = "metric-dimension" ]; then
				./process metric_dimension --algorithm="${method}" < "${source}" > "${target}"
			else
				./process metric_dimension --edge --algorithm="${method}" < "${source}" > "${target}"
			fi
		done
	done
done
