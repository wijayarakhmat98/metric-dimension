#!/usr/bin/env bash

set -euo pipefail

export MODE=''
export MODE="${MODE} metric_dimension"
export MODE="${MODE} edge_metric_dimension"

export METHOD=''
export METHOD="${METHOD} bruteforce"
export METHOD="${METHOD} boolean_satisfiability"
export METHOD="${METHOD} linear_integer_arithmetic"
export METHOD="${METHOD} pseudo_boolean"

export TIMEOUT=300
export INPUT='benchmark-source'
export OUTPUT='benchmark-result'
export SATURATION=10

source="${OUTPUT}/${NAME}.txt"
target="${INPUT}/resume.txt"
touch "${source}"
echo "Reading ${source}... Creating ${target} for ${NAME} job..."
cat "${source}" | ./process remove -r='time|vertices|edges|algorithm|metric_dimension' | sort -u > "${target}"
echo

resume="${INPUT}/resume.txt"
for vertices in $VERTICES; do
	source="${INPUT}/vertices-${vertices}.g6"
	target="${INPUT}/vertices-${vertices}.resume"
	echo "Reading ${source}... Creating ${target}..."
	cat "${source}" | ./process jsonify | ./process resume -c="${resume}" | ./sort > "${target}"
done
echo

for vertices in $VERTICES; do
	source="${INPUT}/vertices-${vertices}.resume"
	target="${INPUT}/vertices-${vertices}.mode"
	echo "Creating ${target}..."
	cp "${source}" "${target}"
	for mode in ${MODE}; do
		source="${INPUT}/vertices-${vertices}.mode.BAK"
		target="${INPUT}/vertices-${vertices}.mode"
		mv "${target}" "${source}"
		echo "Generating for ${mode}..."
		cat "${source}" | ./process add --key="${mode}" | ./sort > "${target}"
		rm -f "${source}"
	done
done
echo

for vertices in $VERTICES; do
	source="${INPUT}/vertices-${vertices}.mode"
	target="${INPUT}/vertices-${vertices}.txt"
	rm -f "${target}"
	echo "Creating ${target}..."
	for method in ${METHOD}; do
		echo "Reading ${source}... Generating for ${method}..."
		cat "${source}" | ./process add --key='algorithm' --value="${method}" | ./sort >> "${target}"
	done
done
echo

target="${INPUT}/${NAME}.txt"
rm -f "${target}"
echo "Creating ${target} for ${NAME} job..."
for vertices in $VERTICES; do
	source="${INPUT}/vertices-${vertices}.txt"
	echo "Reading ${source}..."
	cat "${source}" >> "${target}"
done
echo

mkdir -p "${OUTPUT}"

for ((i = 1; i <= $SATURATION; ++i)); do
	echo "Saturating CPU... (${i} of ${SATURATION})"
	nauty-geng -cq 8 | ./process jsonify | ./process add --key='metric_dimension' | ./process add --key='edge_metric_dimension' | ./process add --key='algorithm' --value='pseudo_boolean' | ./process metric_dimension > /dev/null
done

source="${INPUT}/${NAME}.txt"
target="${OUTPUT}/${NAME}.txt"
echo 'Processing...'
./process metric_dimension < "${source}" >> "${target}"
