#!/usr/bin/env bash

set -euo pipefail

export OUTPUT='benchmark-result'

mkdir -p "${OUTPUT}"

for source in benchmark-result/*.simplified; do
	file="${source%%.simplified}"
	target="${file}.sorted"
	echo "Sorting ${file}..."
	cat "${source}"  | ./sort | ./sort -r='algorithm' | ./sort -r='vertices' > "${target}"
done
