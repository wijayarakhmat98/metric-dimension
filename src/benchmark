#!/usr/bin/env bash

set -euo pipefail

VERTICES_START=2
VERTICES_END=50

export TIMEOUT=180
INPUT='benchmark-source'
OUTPUT='benchmark-result'

MODE=''
MODE="${MODE} metric-dimension"
MODE="${MODE} edge-metric-dimension"

METHOD=''
METHOD="${METHOD} brute-force"
METHOD="${METHOD} boolean-satisfiability"
METHOD="${METHOD} linear-integer-arithmetic"
METHOD="${METHOD} pseudo-boolean"

mkdir -p "${OUTPUT}"

for ((nV = ${VERTICES_START}; nV <= ${VERTICES_END}; ++nV)); do
	for mode in ${MODE}; do
		for method in ${METHOD}; do
			source="${INPUT}/vertices-${nV}.txt"
			target="${OUTPUT}/vertices-${nV}_${mode}_${method}.txt"
			echo -e "[VERTICES ${nV}]\t[FIND ${mode}] \t[ALGORITHM ${method}]"
			./process metric_dimension --find="${mode}" --algorithm="${method}" < "${source}" > "${target}"
		done
	done
done
