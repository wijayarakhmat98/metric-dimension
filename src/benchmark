#!/usr/bin/env bash

set -euo pipefail

VERTICES_START=1
VERTICES_END=50

export TIMEOUT=180
INPUT='benchmark-source'
OUTPUT='benchmark-result'

MODE=''
MODE="${MODE} metric-dimension"
MODE="${MODE} edge-metric-dimension"

METHOD=''
METHOD="${METHOD} bruteforce"
METHOD="${METHOD} boolean_satisfiability"
METHOD="${METHOD} linear_integer_arithmetic"
METHOD="${METHOD} pseudo_boolean"

mkdir -p "${OUTPUT}"

for ((i = 1; i <= 5; ++i)); do
	echo "Initialization ${i}... Saturating CPU..."
	nauty-geng -cq 8 | ./process jsonify | ./process metric_dimension -a=pseudo_boolean | ./process metric_dimension -f=edge-metric-dimension -a=pseudo_boolean > /dev/null
done

for ((nV = ${VERTICES_START}; nV <= ${VERTICES_END}; ++nV)); do
	echo "[VERTICES ${nV}] Saturating CPU..."
	nauty-geng -cq 8 | ./process jsonify | ./process metric_dimension -a=pseudo_boolean | ./process metric_dimension -f=edge-metric-dimension -a=pseudo_boolean > /dev/null
	for mode in ${MODE}; do
		for method in ${METHOD}; do
			source="${INPUT}/vertices-${nV}.txt"
			target="${OUTPUT}/vertices-${nV}_${mode}_${method}.txt"
			echo -e "[VERTICES ${nV}]\t[FIND ${mode}] \t[ALGORITHM ${method}]"
			./process metric_dimension --find="${mode}" --algorithm="${method}" < "${source}" > "${target}"
		done
	done
done
