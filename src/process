#!/usr/bin/env python3.13

import multiprocessing
import os
import re
import signal
import sys
from typing import Any, Callable, cast, Dict, List, Optional, Protocol, Tuple
from utils import load_module, parse_args, parse_switch, read_file

signal.signal(signal.SIGPIPE, signal.SIG_DFL)

class ProtocolProcess(Protocol):
	preserve_order : bool
	header : Optional[Callable[[Dict[str, Any]], str]]
	decode : Callable[[str], Optional[Dict[str, Any]]]
	transform : Callable[[Optional[Dict[str, Any]], Tuple[Any, ...]], Optional[Dict[str, Any]]]
	encode : Callable[[Optional[Dict[str, Any]]], Optional[str]]
	option_spec : Optional[List[Tuple[List[str], Any, Optional[Callable[[str], Any]]]]]
	option_valid : Optional[Callable[[Tuple[Any, ...]], bool]]
	option_augment : Optional[Callable[[Tuple[Any, ...]], Tuple[Any, ...]]]
	help : Callable[[], str]

def worker_initialize(module_name : str, process_option : Tuple[Any, ...]) -> None:
	global process, option
	process = cast(ProtocolProcess, load_module('process_module.{}'.format(module_name)))
	option = process_option

def process_compose(iresult : str) -> Optional[str]:
	global process, option
	datum = process.decode(iresult)
	datum = process.transform(datum, option)
	oresult = process.encode(datum)
	return oresult

def process_compose_for_header(iresult : str) -> Tuple[Optional[Dict[str, Any]], Optional[str]]:
	global process, option
	datum = process.decode(iresult)
	datum = process.transform(datum, option)
	oresult = process.encode(datum)
	return datum, oresult

def main(args : List[str]) -> None:
	print_help, number_of_threads = cast(
		Tuple[bool, int],
		parse_args(args[1:], [
			(['-h', '--help'], False, parse_switch),
			(['-t', '--threads'], -1, int)
		])
	)
	if number_of_threads < 0:
		number_of_threads = os.cpu_count() or 1
		if 'THREADS' in os.environ:
			try:
				number_of_threads = int(os.environ['THREADS'])
			except:
				pass
	if len(args) < 1:
		print(help(), file=sys.stderr)
		return
	module_name = args[0]
	process = cast(ProtocolProcess, load_module('process_module.{}'.format(module_name)))
	if print_help:
		print(process.help(), file=sys.stderr)
		return
	if process.option_spec is not None:
		process_option = parse_args(args, process.option_spec)
		if  process.option_valid is not None and not process.option_valid(process_option):
			print(process.help(), file=sys.stderr)
			return
	else:
		process_option = cast(Tuple[Any, ...], ())
	if process.option_augment:
		process_option = process.option_augment(process_option)
	results = read_file(sys.stdin)
	try:
		with multiprocessing.Pool(processes=number_of_threads, initializer=worker_initialize, initargs=(module_name, process_option)) as pool:
			if process.preserve_order:
				pool_imap = pool.imap
			else:
				pool_imap = pool.imap_unordered
			if process.header is None:
				for result in pool_imap(process_compose, results):
					if result:
						print(result)
			else:
				print_header = True
				for datum, result in pool_imap(process_compose_for_header, results):
					if datum:
						if print_header:
							print(process.header(datum))
							print_header = False
						if result:
							print(result)
	except BrokenPipeError:
		return

def help() -> str:
	return re.sub(r'\n\t\t', r'\n',
	'''
		usage:
			<process module> [-t=<number of threads>]
				Read graphs from stdin.

		options:
			-h, --help
				Prints the module help page.

			-t, --threads
				Set the amount of threads for multiprocessing.
				Defaults to the number of logical cores.
	'''
	).strip()

if __name__ == '__main__':
	main(sys.argv[1:])
